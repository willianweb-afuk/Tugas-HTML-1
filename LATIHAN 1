<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Formulir Pendaftaran</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 30px;
            font-family: Arial, sans-serif;
            background-color: #f2f6f8;
            color: #333;
        }

        .container {
            width: 100%;
            max-width: 650px;
            margin: auto;
            background-color: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

        h1 {
            text-align: center;
            margin-bottom: 25px;
            font-size: 28px;
        }

        fieldset {
            border: 1px solid #aaa;
            padding: 20px;
            margin-bottom: 15px;
            border-radius: 5px;
        }

        legend {
            font-weight: bold;
            padding: 0 8px;
        }

        .form-row {
            display: flex;
            align-items: center;
            margin-bottom: 12px;
        }

        .form-row label {
            width: 180px;
        }

        input[type="text"],
        input[type="password"] {
            width: 100%;
            max-width: 300px;
            padding: 8px;
            border: 1px solid #999;
            border-radius: 3px;
        }

        .pilihan {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .pilihan label {
            width: auto;
        }

        .tombol {
            margin-top: 10px;
            display: flex;
            gap: 8px;
        }

        button {
            padding: 8px 18px;
            border: 1px solid #888;
            background-color: #e9eef0;
            border-radius: 4px;
            cursor: pointer;
        }

        button:hover {
            background-color: #d8e0e3;
        }

        @media (max-width: 600px) {
            body {
                padding: 15px;
            }

            .container {
                padding: 18px;
            }

            .form-row {
                display: block;
            }

            .form-row label {
                display: block;
                width: 100%;
                margin-bottom: 5px;
            }

            input[type="text"],
            input[type="password"] {
                max-width: 100%;
            }
        }
    </style>
</head>

<body>

    <main class="container">

        <h1>Formulir Pendaftaran</h1>

        <form>

            <!-- Bagian Akun -->
            <fieldset>
                <legend>Akun</legend>

                <div class="form-row">
                    <label for="username">Username</label>
                    <input type="text" id="username" name="username" required>
                </div>

                <div class="form-row">
                    <label for="password">Password</label>
                    <input type="password" id="password" name="password" required>
                </div>

                <div class="form-row">
                    <label for="konfirmasi">Konfirmasi Password</label>
                    <input type="password" id="konfirmasi" name="konfirmasi" required>
                </div>
            </fieldset>

            <!-- Bagian Data -->
            <fieldset>
                <legend>Data</legend>

                <div class="form-row">
                    <label for="nama">Nama</label>
                    <input type="text" id="nama" name="nama" required>
                </div>

                <div class="form-row">
                    <label>Jenis Kelamin</label>

                    <div class="pilihan">
                        <label>
                            <input type="radio" name="jenis_kelamin" value="pria" required>
                            Pria
                        </label>

                        <label>
                            <input type="radio" name="jenis_kelamin" value="perempuan">
                            Perempuan
                        </label>
                    </div>
                </div>

                <div class="form-row">
                    <label>Informasi Yang Disukai</label>

                    <div class="pilihan">
                        <label>
                            <input type="checkbox" name="informasi" value="olahraga">
                            Olahraga
                        </label>

                        <label>
                            <input type="checkbox" name="informasi" value="travelling">
                            Travelling
                        </label>

                        <label>
                            <input type="checkbox" name="informasi" value="kesehatan">
                            Kesehatan
                        </label>
                    </div>
                </div>

            </fieldset>

            <!-- Tombol -->
            <div class="tombol">
                <button type="submit">Daftar</button>
                <button type="reset">Reset</button>
            </div>

        </form>

    </main>

</body>
</html>
